{
  "name": "cat-hunting-game",
  "version": "1.0.0",
  "description": "给猫咪玩的互动捕猎游戏",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8080",
    "test": "vitest run --exclude e2e",
    "test:watch": "vitest --exclude e2e",
    "test:coverage": "vitest run --coverage --exclude e2e",
    "test:e2e": "playwright test",
    "build:android": "cordova build android",
    "build:android-release": "cordova build android --release"
  },
  "keywords": [
    "cat",
    "game",
    "pet",
    "interactive"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.8",
    "vitest": "^4.1.8"
  }
}
