{
  "name": "cat-hunting-game",
  "version": "1.0.0",
  "description": "给猫咪玩的互动捕猎游戏",
  "main": "index.html",
  "scripts": {
    "start": "node start.js",
    "start:prod": "node start.js --mode prod",
    "start:check": "node start.js --check",
    "test": "vitest run --exclude e2e",
    "test:watch": "vitest --exclude e2e",
    "test:coverage": "vitest run --coverage --exclude e2e",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "cat",
    "game",
    "pet",
    "interactive"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "rollup": "^4.62.2",
    "vitest": "^4.1.8"
  }
}
